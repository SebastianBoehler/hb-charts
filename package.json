{
  "name": "@hb-capital/charts",
  "version": "0.1.1",
  "description": "Native Canvas2D financial charts for research interfaces.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "import": "./src/react/index.ts"
    },
    "./providers/bybit": {
      "types": "./src/providers/bybit.ts",
      "import": "./src/providers/bybit.ts"
    },
    "./providers/okx": {
      "types": "./src/providers/okx.ts",
      "import": "./src/providers/okx.ts"
    }
  },
  "files": [
    "src",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:files": "bun scripts/check-file-size.ts",
    "check": "bun run check:files && bun run typecheck && bun test && bun run build",
    "playground": "vite playground",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "canvas",
    "candlestick",
    "charting",
    "finance",
    "trading"
  ],
  "author": "HB Capital UG (haftungsbeschränkt)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebastianBoehler/hb-charts.git"
  },
  "homepage": "https://www.hb-capital.app/charts",
  "bugs": {
    "url": "https://github.com/SebastianBoehler/hb-charts/issues"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.3"
  }
}
